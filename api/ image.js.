export default async function handler(req, res) {
  if (req.method !== "POST") {
    return res.status(405).json({ error: "Method not allowed." });
  }

  try {
    const { prompt, size = "square" } = req.body || {};

    if (!prompt || typeof prompt !== "string" || !prompt.trim()) {
      return res.status(400).json({ error: "Please enter an image description." });
    }

    if (prompt.length > 2000) {
      return res.status(400).json({ error: "Image description is too long." });
    }

    const apiKey = process.env.OPENROUTER_API_KEY;

    if (!apiKey) {
      return res.status(500).json({
        error: "Image generation is not configured. Check your Vercel environment variables."
      });
    }

    const dimensions = {
      square: "1024x1024",
      portrait: "1024x1536",
      landscape: "1536x1024"
    };

    const response = await fetch("https://openrouter.ai/api/v1/images", {
      method: "POST",
      headers: {
        "Authorization": `Bearer ${apiKey}`,
        "Content-Type": "application/json",
        "HTTP-Referer": "https://clario-ai.vercel.app",
        "X-Title": "CLARIO AI"
      },
      body: JSON.stringify({
        model: process.env.CLARIO_IMAGE_MODEL || "bytedance-seed/seedream-4.5",
        prompt: prompt.trim(),
        size: dimensions[size] || dimensions.square
      })
    });

    const result = await response.json();

    if (!response.ok) {
      return res.status(response.status).json({
        error: result.error?.message || "The image provider could not generate your image."
      });
    }

    const image = result.data?.[0]?.b64_json
      ? `data:image/png;base64,${result.data[0].b64_json}`
      : result.data?.[0]?.url;

    if (!image) {
      return res.status(502).json({ error: "No image was returned by the provider." });
    }

    return res.status(200).json({ image });
  } catch (error) {
    console.error("CLARIO image error:", error);
    return res.status(500).json({ error: "Something went wrong while generating the image." });
  }
}